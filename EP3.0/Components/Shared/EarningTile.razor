<div class="earning-tile">
    <i class="bi @Icon" aria-hidden="true"></i>
    <span class="label">@Title</span>
    <span class="value">@(IsCurrency ? $"PKR {Amount:N0}" : Amount.ToString("N0"))</span>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public decimal Amount { get; set; }
    [Parameter, EditorRequired] public string Icon { get; set; } = "bi-cash";
    [Parameter] public bool IsCurrency { get; set; } = true;
}