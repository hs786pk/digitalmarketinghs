@inherits LayoutComponentBase

<EarnPlatform.Components.Shared.NavProgressWatcher />

<div class="user-shell">
    <header class="user-topbar">
        <div class="d-flex align-items-center">
            <i class="bi bi-cash-coin text-primary me-2 fs-4"></i>
            <span class="fw-bold">Digital-Marketing Group</span>
        </div>
        <form method="post" action="/account/logout" class="d-inline">
            <AntiforgeryToken /><button type="submit" class="btn btn-sm btn-outline-danger">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button></form>
    </header>

    <main class="user-content">
        @Body
    </main>

    <EarnPlatform.Components.Shared.BottomNav />
</div>