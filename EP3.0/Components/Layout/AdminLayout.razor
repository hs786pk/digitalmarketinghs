@inherits LayoutComponentBase

<EarnPlatform.Components.Shared.NavProgressWatcher />

<div class="user-shell">
    <header class="user-topbar">
        <a href="/admin" class="app-brand" aria-label="Digital-Marketing Group dashboard">
            <span class="brand-mark" aria-hidden="true">DM</span>
            <span class="app-brand-name">Digital-Marketing Group</span>
            <span class="app-brand-tag">Admin</span>
        </a>
        <form method="post" action="/account/logout" class="d-inline">
            <AntiforgeryToken /><button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button></form>
    </header>

    <main class="user-content">
        @Body
    </main>

    <EarnPlatform.Components.Shared.AdminBottomNav />
</div>