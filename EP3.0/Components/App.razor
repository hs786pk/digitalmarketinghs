<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <base href="/" />

    <title>Digital-Marketing Group | Online Earning & Referral Platform in Pakistan</title>

    <meta name="description"
          content="Digital-Marketing Group is an online earning platform in Pakistan offering task-based earnings, referral rewards, account levels and wallet withdrawals." />

    <meta name="keywords"
          content="online earning Pakistan, earn online Pakistan, task earning, referral earning, online earning platform, digital marketing earning, JazzCash withdrawal, Easypaisa withdrawal" />

    <meta name="author"
          content="Digital-Marketing Group" />

    <meta name="robots"
          content="index, follow" />

    <link rel="canonical"
          href="https://digital-marketingpk.com/" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type"
          content="website" />

    <meta property="og:title"
          content="Digital-Marketing Group | Online Earning Platform" />

    <meta property="og:description"
          content="Earn through tasks, referral rewards and account-level benefits with Digital-Marketing Group." />

    <meta property="og:url"
          content="https://digital-marketingpk.com/" />

    <meta property="og:site_name"
          content="Digital-Marketing Group" />

    <meta property="og:image"
          content="https://digital-marketingpk.com/images/og-image.jpg" />

    <!-- Twitter / X -->
    <meta name="twitter:card"
          content="summary_large_image" />

    <meta name="twitter:title"
          content="Digital-Marketing Group | Online Earning Platform" />

    <meta name="twitter:description"
          content="Task-based earnings, referral rewards and wallet withdrawals with Digital-Marketing Group." />

    <meta name="twitter:image"
          content="https://digital-marketingpk.com/images/og-image.jpg" />

    <meta name="theme-color"
          content="#0f172a" />

    <ResourcePreloader />
    <link rel="stylesheet" href="css/fonts.css" />
    <link rel="stylesheet" href="lib/bootstrap-icons/bootstrap-icons.css" />


    <link rel="stylesheet"
          href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />

    <link rel="stylesheet"
          href="@Assets["app.css"]" />

    <link rel="stylesheet"
          href="css/site.css" />

    <link rel="stylesheet"
          href="@Assets["EarnPlatform.styles.css"]" />

    <link rel="icon"
          type="image/png"
          href="favicon.png" />

    <ImportMap />

    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <div class="nav-progress-bar"><div class="nav-progress-bar-inner"></div></div>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="js/site.js"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? InteractiveServer =>
        HttpContext.AcceptsInteractiveRouting()
            ? Microsoft.AspNetCore.Components.Web.RenderMode.InteractiveServer
            : null;
}