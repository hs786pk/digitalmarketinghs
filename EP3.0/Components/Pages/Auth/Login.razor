@page "/login"
@attribute [ExcludeFromInteractiveRouting]
@layout Components.Layout.AuthLayout
@using EarnPlatform.Models
@using EarnPlatform.Repositories.Interfaces
@using EarnPlatform.Services.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Endpoints
@inject IAuthService AuthService
@inject IUserAccountRepository UserAccountRepository
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login | Digital-Marketing Group</PageTitle>

<HeadContent>
    <meta name="description"
          content="Log in to your Digital-Marketing Group account to access your dashboard, tasks, earnings, referrals and wallet." />

    <meta name="robots" content="noindex, nofollow" />

    <link rel="canonical"
          href="https://digital-marketingpk.com/login" />

    <meta property="og:title"
          content="Login | Digital-Marketing Group" />

    <meta property="og:description"
          content="Log in to your Digital-Marketing Group account." />

    <meta property="og:url"
          content="https://digital-marketingpk.com/login" />
</HeadContent>

<div class="auth-card">
    <div class="text-center mb-4">
        <i class="bi bi-cash-coin text-primary auth-login-icon"></i>
        <h5 class="fw-bold mt-2 mb-0">Digital-Marketing Group</h5>
        <h3 class="fw-bold mt-2">Welcome Back</h3>
        <p class="text-muted">Sign in to continue earning</p>
    </div>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger py-2 rounded">@_errorMessage</div>
    }

    <EditForm Model="_model" FormName="LoginForm" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText @bind-Value="_model.Email" class="form-control" placeholder="you@example.com" />
            <ValidationMessage For="() => _model.Email" class="text-danger small" />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <InputText @bind-Value="_model.Password" type="password" class="form-control" placeholder="••••••••" />
            <ValidationMessage For="() => _model.Password" class="text-danger small" />
        </div>

        <div class="form-check mb-3">
            <InputCheckbox @bind-Value="_model.RememberMe" class="form-check-input" id="rememberMe" />
            <label class="form-check-label" for="rememberMe">Remember me</label>
        </div>

        <button type="submit" class="btn btn-primary w-100 py-2">
            Login
        </button>
    </EditForm>

    <div class="text-center mt-4">
        <span class="text-muted">Don't have an account?</span>
        <a href="/signup" class="fw-semibold text-decoration-none"> Sign Up</a>
    </div>
</div>

@code {
#pragma warning disable BL0008
    [SupplyParameterFromForm]
    private LoginModel _model { get; set; } = new();
#pragma warning restore BL0008

    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        // GET request, no login happened yet this request -> HttpContext.User
        // reflects the real current cookie. Safe to use AuthStateProvider here.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            var landing = await ResolveLandingPageFromClaimsAsync(authState);
            NavigationManager.NavigateTo(landing, forceLoad: true);
        }
    }

    private async Task HandleLoginAsync()
    {
        _errorMessage = null;

        try
        {
            var result = await AuthService.LoginAsync(_model.Email, _model.Password, _model.RememberMe);

            if (!result.Succeeded)
            {
                _errorMessage = result.ErrorMessage;
                return;
            }

            // Do NOT use AuthStateProvider/HttpContext.User here. SignInAsync
            // (called inside AuthService.LoginAsync) only writes the auth
            // cookie to the response for the *next* request — it does not
            // update HttpContext.User for the request currently executing.
            // Reading auth state at this point returns the pre-login
            // principal, which is what caused: logout -> login as Admin ->
            // wrongly routed to /user -> Access Denied.
            //
            // LoginResult already carries the role/status/selected-package
            // computed inside LoginAsync itself, so use that directly.
            var landing = ResolveLandingPageFromLoginResult(result);
            NavigationManager.NavigateTo(landing, forceLoad: true);
        }
        catch (InvalidOperationException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = "Something went wrong signing you in. Please try again.";
        }
    }

    private static string ResolveLandingPageFromLoginResult(LoginResult result)
    {
        if (result.IsAdmin)
            return "/admin";

        if (result.AccountStatus.HasValue)
            return ResolveNonAdminLandingPage(result.AccountStatus.Value, result.SelectedPackageId);

        return "/user";
    }

    // Only used in OnInitializedAsync, on a fresh GET where AuthStateProvider is trustworthy.
    private async Task<string> ResolveLandingPageFromClaimsAsync(AuthenticationState authState)
    {
        if (authState.User.IsInRole("Admin"))
            return "/admin";

        var applicationUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        var userAccount = applicationUserId != null
            ? await UserAccountRepository.GetByApplicationUserIdAsync(applicationUserId)
            : null;

        if (userAccount != null)
            return ResolveNonAdminLandingPage(userAccount.AccountStatus, userAccount.SelectedPackageId);

        return "/user";
    }

    // A non-admin user's AccountStatus stays "PendingApproval" through the
    // whole onboarding flow (signup -> package selection -> payment submission
    // -> admin review), so status alone can't tell us where they are.
    // SelectedPackageId is only ever set once a payment has actually been
    // submitted (see PaymentApprovalService.SubmitPaymentAsync) and is cleared
    // back to null on rejection (see WalletService.RejectPaymentAsync), so it's
    // the right signal for "has this user actually submitted a payment yet?".
    private static string ResolveNonAdminLandingPage(AccountStatus status, int? selectedPackageId)
    {
        if (status == AccountStatus.Active)
            return "/user";

        // Brand-new user, or a rejected user who needs to pick again — no
        // payment is currently under review, so send them back into the
        // onboarding flow instead of the "awaiting review" dead-end page.
        if (status == AccountStatus.PendingApproval && selectedPackageId == null)
            return "/packages";

        return "/user/pending-approval";
    }

    public class LoginModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Email is required.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }
}