@page "/packages"
@attribute [Authorize(Policy = "RequireUserRole")]
@layout Components.Layout.AuthLayout
@using EarnPlatform.Models
@using EarnPlatform.Services.Interfaces
@using EarnPlatform.Repositories.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@inject IPackageService PackageService
@inject IUserAccountRepository UserAccountRepository
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Choose Your Package</PageTitle>

<div class="package-selection-page">
    <div class="d-flex justify-content-end mb-2">
        <form method="post" action="/account/logout" class="d-inline">
            <AntiforgeryToken /><button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button></form>
    </div>

    <div class="text-center mb-5">
        <span class="eyebrow">Membership Plans</span>
        <h3 class="fw-bold page-title">Choose Your Package</h3>
        <p class="page-subtitle">Select a plan to start earning. You can view pricing and daily limits below.</p>
    </div>

    @if (_packages == null)
    {
        <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
    }
    else if (_packages.Count == 0)
    {
        <div class="alert alert-warning text-center rounded">No packages are currently available. Please check back later.</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var package in _packages)
            {
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="package-card @(_selectedPackageId == package.Id ? "selected" : "")"
                         @onclick="() => SelectPackage(package.Id)">
                        @if (_selectedPackageId == package.Id)
                        {
                            <div class="package-check"><i class="bi bi-check-lg"></i></div>
                        }
                        <div class="package-header">
                            <span class="package-level"><i class="bi bi-layers"></i> Level @package.Level</span>
                            <h5 class="package-name">@package.Name</h5>
                        </div>
                        <div class="package-body">
                            <div class="price"><span class="price-currency">PKR</span>@package.Price.ToString("N0")</div>
                            <div class="package-limit"><i class="bi bi-calendar-check"></i> @package.DailyAdLimit ad(s)/day</div>
                            @if (!string.IsNullOrWhiteSpace(package.Description))
                            {
                                <p class="package-desc">@package.Description</p>
                            }
                            <button type="button" class="btn @(_selectedPackageId == package.Id ? "btn-selected" : "btn-outline-primary") w-100 package-select-btn"
                                    @onclick="() => SelectPackage(package.Id)"
                                    @onclick:stopPropagation="true">
                                @(_selectedPackageId == package.Id ? "Selected" : "Select")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="text-center mt-5">
            <button class="btn btn-primary btn-continue px-4 py-2" disabled="@(_selectedPackageId == null)" @onclick="ProceedToPayment">
                Continue to Payment <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    }
</div>

@code {
    private List<Package>? _packages;
    private int? _selectedPackageId;

    protected override async Task OnInitializedAsync()
    {
        _packages = await PackageService.GetActivePackagesAsync();
    }

    private void SelectPackage(int packageId) => _selectedPackageId = packageId;

    private void ProceedToPayment()
    {
        if (_selectedPackageId != null)
            NavigationManager.NavigateTo($"/payment?packageId={_selectedPackageId}");
    }
}