@page "/payment"
@attribute [Authorize(Policy = "RequireUserRole")]
@layout Components.Layout.AuthLayout
@using EarnPlatform.Models
@using EarnPlatform.Services.Interfaces
@using EarnPlatform.Repositories.Interfaces
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@inject IPackageService PackageService
@inject ISettingsService SettingsService
@inject IPaymentApprovalService PaymentApprovalService
@inject IFileUploadService FileUploadService
@inject IUserAccountRepository UserAccountRepository
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<PageTitle>Complete Your Payment</PageTitle>

<div class="payment-submission-page">
    <div class="d-flex justify-content-end mb-2">
        <form method="post" action="/account/logout" class="d-inline">
            <AntiforgeryToken /><button type="submit" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button></form>
    </div>

    @if (_package == null || _appSettings == null)
    {
        <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
    }
    else
    {
        <div class="auth-card mx-auto">
            <h4 class="fw-bold text-center mb-1">Payment Instructions</h4>
            <p class="text-muted text-center mb-4">Send payment to the account below, then submit your proof.</p>

            <div class="card p-3 mb-3">
                <div class="d-flex justify-content-between"><span class="text-muted">Account Name</span><strong>@_appSettings.PaymentAccountName</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Account Number</span><strong>@_appSettings.PaymentAccountNumber</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Package</span><strong>@_package.Name</strong></div>
                <div class="d-flex justify-content-between"><span class="text-muted">Amount to Pay</span><strong class="text-primary">PKR @_package.Price.ToString("N0")</strong></div>
            </div>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="alert alert-danger py-2 rounded">@_errorMessage</div>
            }

            <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">Payment Screenshot</label>
                    <InputFile OnChange="HandleFileSelected" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                    <div class="form-text">JPG, PNG, or WEBP — max 5 MB.</div>
                    @if (_fileError != null)
                    {
                        <div class="text-danger small">@_fileError</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Account Name (sender)</label>
                    <InputText @bind-Value="_model.AccountName" class="form-control" />
                    <ValidationMessage For="() => _model.AccountName" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Transaction ID</label>
                    <InputText @bind-Value="_model.TransactionId" class="form-control" />
                    <ValidationMessage For="() => _model.TransactionId" class="text-danger small" />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    Done / Submit Payment
                </button>
            </EditForm>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "packageId")]
    public int PackageId { get; set; }

    private Package? _package;
    private AppSettings? _appSettings;
    private readonly PaymentModel _model = new();
    private IBrowserFile? _selectedFile;
    private string? _fileError;
    private string? _errorMessage;
    private bool _isSubmitting;

    protected override async Task OnInitializedAsync()
    {
        _package = await PackageService.GetByIdAsync(PackageId);
        _appSettings = await SettingsService.GetPaymentSettingsAsync();

        if (_package == null)
            NavigationManager.NavigateTo("/packages");
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _fileError = null;
        var file = e.File;

        const long maxSize = 5 * 1024 * 1024;
        if (file.Size > maxSize)
        {
            _fileError = "File must be smaller than 5 MB.";
            _selectedFile = null;
            return;
        }

        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (!allowed.Contains(ext))
        {
            _fileError = "Only .jpg, .jpeg, .png, and .webp files are allowed.";
            _selectedFile = null;
            return;
        }

        _selectedFile = file;
    }

    private async Task HandleSubmitAsync()
    {
        _errorMessage = null;

        if (_selectedFile == null)
        {
            _fileError = "Please upload a payment screenshot.";
            return;
        }

        _isSubmitting = true;

        try
        {
            // Resolve and validate the current user BEFORE touching storage, so a
            // failed/expired session can never leave an orphaned screenshot behind.
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var applicationUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            var userAccount = applicationUserId != null
                ? await UserAccountRepository.GetByApplicationUserIdAsync(applicationUserId)
                : null;

            if (userAccount == null)
            {
                _errorMessage = "Could not verify your account. Please log in again.";
                return;
            }

            await using var stream = _selectedFile.OpenReadStream(5 * 1024 * 1024); // enforce max size at the stream level too
            var uploadResult = await FileUploadService.SavePaymentScreenshotAsync(stream, _selectedFile.Name, _selectedFile.Size);

            if (!uploadResult.Succeeded)
            {
                _errorMessage = uploadResult.ErrorMessage;
                return;
            }

            await PaymentApprovalService.SubmitPaymentAsync(
                userAccount.Id, PackageId,
                accountName: _model.AccountName,
                transactionId: _model.TransactionId,
                screenshotPath: uploadResult.RelativePath!);

            NavigationManager.NavigateTo("/payment-pending");
        }
        catch (AppException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = "Something went wrong. Please try again.";
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class PaymentModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Account name is required.")]
        public string AccountName { get; set; } = string.Empty;

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Transaction ID is required.")]
        public string TransactionId { get; set; } = string.Empty;
    }
}