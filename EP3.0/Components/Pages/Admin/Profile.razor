@page "/admin/profile"
@attribute [Authorize(Policy = "RequireAdminRole")]
@layout Components.Layout.AdminLayout
@using EarnPlatform.Services.Interfaces
@inject ICurrentUserService CurrentUserService
@inject NavigationManager NavigationManager

<PageTitle>Admin Profile</PageTitle>

@if (_admin == null)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
}
else
{
    <h4 class="fw-bold mb-3">Profile</h4>
    <div class="card p-3">
        <ProfileRow Label="Name" Value="@_admin.Name" />
        <ProfileRow Label="Email" Value="@_admin.Email" />
        <ProfileRow Label="Role" Value="@_admin.Role" IsLast="true" />
    </div>
    <form method="post" action="/account/logout" class="d-inline">
            <AntiforgeryToken /><button type="submit" class="btn btn-outline-danger w-100 mt-3">
        <i class="bi bi-box-arrow-right me-1"></i> Logout
    </button></form>
}

@code {
    private Models.AdminAccount? _admin;

    protected override async Task OnInitializedAsync()
    {
        _admin = await CurrentUserService.GetCurrentAdminAccountAsync();
        if (_admin == null)
            NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}