@page "/admin/withdrawals"
@attribute [Authorize(Policy = "RequireAdminRole")]
@layout Components.Layout.AdminLayout
@using EarnPlatform.Models
@using EarnPlatform.Services.Interfaces
@inject IWithdrawalService WithdrawalService

<PageTitle>Withdrawal Approvals</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="fw-bold mb-0">Withdrawals</h4>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="todayOnly" @bind="_todayOnly" />
        <label class="form-check-label small" for="todayOnly">Today only</label>
    </div>
</div>

@if (_actionError != null)
{
    <div class="alert alert-danger rounded">@_actionError</div>
}

<ul class="nav nav-pills mb-3">
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "pending" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => _activeTab = "pending"'>
            Pending <span class="badge bg-warning ms-1">@CountFor(WithdrawalStatus.Pending)</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "approved" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => _activeTab = "approved"'>
            Approved <span class="badge bg-warning ms-1">@CountFor(WithdrawalStatus.Approved)</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "rejected" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => _activeTab = "rejected"'>
            Rejected <span class="badge bg-warning ms-1">@CountFor(WithdrawalStatus.Rejected)</span>
        </a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(_activeTab == "all" ? "active" : "")" href="#" @onclick:preventDefault @onclick='() => _activeTab = "all"'>
            All <span class="badge bg-warning ms-1">@FilteredByDate().Count</span>
        </a>
    </li>
</ul>

@if (_allRequests == null)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
}
else
{
    var visible = VisibleRequests();

    @if (visible.Count == 0)
    {
        <div class="text-center text-muted py-5 card">
            <i class="bi bi-inbox fs-2 d-block mb-1"></i>
            No withdrawal requests found for this view.
        </div>
    }
    else
    {
        <div class="table-responsive card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="text-muted small">
                        <th>User</th>
                        <th>Method</th>
                        <th>Account</th>
                        <th>Amount</th>
                        <th>Requested</th>
                        <th>Status</th>
                        <th>Processed</th>
                        <th>Remarks</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var req in visible)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold small">@req.User.FirstName @req.User.LastName</div>
                                <div class="text-muted small">@req.User.Email</div>
                            </td>
                            <td class="small">@req.PaymentMethod</td>
                            <td class="small">@req.AccountNumber</td>
                            <td class="fw-bold small">PKR @req.Amount.ToString("N0")</td>
                            <td class="small">@EarnPlatform.Common.DisplayTime.FormatDateTime(req.RequestedAt)</td>
                            <td><EarnPlatform.Components.Shared.StatusBadge Status="@req.Status.ToString()" /></td>
                            <td class="small">@(req.ProcessedAt is DateTime pa ? EarnPlatform.Common.DisplayTime.Format(pa) : "—")</td>
                            <td class="small text-muted">@(req.AdminRemarks ?? "—")</td>
                            <td>
                                @if (req.Status == WithdrawalStatus.Pending)
                                {
                                    <div class="d-flex gap-1">
                                        <button class="btn btn-sm btn-success" disabled="@(_processingId == req.Id)" @onclick="() => OpenApprove(req.Id)"><i class="bi bi-check-lg"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@(_processingId == req.Id)" @onclick="() => OpenReject(req.Id)"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

<EarnPlatform.Components.Shared.ConfirmDialog
    IsOpen="@_approveOpen"
    Title="Approve Withdrawal"
    Message="Confirm this withdrawal has been paid out to the user."
    ConfirmText="Approve"
    ConfirmButtonClass="btn-success"
    OnConfirm="HandleApproveConfirmedAsync"
    OnCancel="() => _approveOpen = false" />

@if (_rejectOpen)
{
    <div class="modal-backdrop-custom">
        <div class="confirm-dialog">
            <h6 class="fw-bold">Reject Withdrawal</h6>
            <p class="text-muted small">Funds will be returned to the user's wallet balance.</p>
            <textarea class="form-control mb-2" placeholder="Reason for rejection..." @bind="_remarks" rows="3"></textarea>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => _rejectOpen = false">Cancel</button>
                <button class="btn btn-sm btn-danger" disabled="@string.IsNullOrWhiteSpace(_remarks)" @onclick="HandleRejectConfirmedAsync">Reject</button>
            </div>
        </div>
    </div>
}

@code {
    private List<WithdrawalRequest>? _allRequests;
    private string _activeTab = "pending";
    private bool _todayOnly;

    private bool _approveOpen;
    private bool _rejectOpen;
    private int _targetId;
    private string _remarks = string.Empty;
    private int? _processingId;
    private string? _actionError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _allRequests = await WithdrawalService.GetAllRequestsAsync();
        StateHasChanged();
    }

    private List<WithdrawalRequest> FilteredByDate()
    {
        if (_allRequests == null) return new List<WithdrawalRequest>();
        if (!_todayOnly) return _allRequests;

        var today = EarnPlatform.Common.DisplayTime.BusinessToday;
        return _allRequests.Where(w => EarnPlatform.Common.DisplayTime.ToBusinessLocal(w.RequestedAt).Date == today).ToList();
    }

    private List<WithdrawalRequest> VisibleRequests()
    {
        var byDate = FilteredByDate();

        return _activeTab switch
        {
            "pending" => byDate.Where(w => w.Status == WithdrawalStatus.Pending).ToList(),
            "approved" => byDate.Where(w => w.Status == WithdrawalStatus.Approved).ToList(),
            "rejected" => byDate.Where(w => w.Status == WithdrawalStatus.Rejected).ToList(),
            _ => byDate
        };
    }

    private int CountFor(WithdrawalStatus status) =>
        FilteredByDate().Count(w => w.Status == status);

    private void OpenApprove(int id) { _targetId = id; _approveOpen = true; }
    private void OpenReject(int id) { _targetId = id; _remarks = string.Empty; _rejectOpen = true; }

    private async Task HandleApproveConfirmedAsync()
    {
        _approveOpen = false;
        _actionError = null;
        _processingId = _targetId;
        StateHasChanged();

        try
        {
            await WithdrawalService.ApproveAsync(_targetId, remarks: null);
        }
        catch (AppException ex)
        {
            _actionError = ex.Message;
        }
        catch (Exception)
        {
            _actionError = "Something went wrong. Please try again.";
        }
        finally
        {
            _processingId = null;
            await LoadAsync();
        }
    }

    private async Task HandleRejectConfirmedAsync()
    {
        _rejectOpen = false;
        _actionError = null;
        _processingId = _targetId;
        StateHasChanged();

        try
        {
            await WithdrawalService.RejectAsync(_targetId, _remarks);
        }
        catch (AppException ex)
        {
            _actionError = ex.Message;
        }
        catch (Exception)
        {
            _actionError = "Something went wrong. Please try again.";
        }
        finally
        {
            _processingId = null;
            await LoadAsync();
        }
    }
}