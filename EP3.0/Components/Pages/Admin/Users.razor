@page "/admin/users"
@attribute [Authorize(Policy = "RequireAdminRole")]
@layout Components.Layout.AdminLayout
@using EarnPlatform.Models
@using EarnPlatform.Repositories.Interfaces
@inject IUserAccountRepository UserAccountRepository

<PageTitle>Users</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="fw-bold mb-0">Users</h4>
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="todayOnly" @bind="_todayOnly" />
        <label class="form-check-label small" for="todayOnly">Added today</label>
    </div>
</div>

<div class="mb-3">
    <input class="form-control" placeholder="Search by name or email..." @bind="_search" @bind:event="oninput" />
</div>

@if (_users == null)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
}
else
{
    var today = EarnPlatform.Common.DisplayTime.BusinessToday;

    var filtered = _users
        .Where(u => !_todayOnly || EarnPlatform.Common.DisplayTime.ToBusinessLocal(u.CreatedAt).Date == today)
        .Where(u => string.IsNullOrWhiteSpace(_search)
            || $"{u.FirstName} {u.LastName}".Contains(_search, StringComparison.OrdinalIgnoreCase)
            || u.Email.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    <p class="text-muted small">@filtered.Count user(s) @(_todayOnly ? "joined today" : "total")</p>

    <div class="table-responsive card">
        <table class="table align-middle mb-0">
            <thead>
                <tr class="text-muted small">
                    <th>Name</th>
                    <th>Email</th>
                    <th>Package</th>
                    <th>Level</th>
                    <th>Status</th>
                    <th>Joined</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in filtered)
                {
                    <tr>
                        <td class="small fw-semibold">@user.FirstName @user.LastName</td>
                        <td class="small">@user.Email</td>
                        <td class="small">@(user.SelectedPackage?.Name ?? "—")</td>
                        <td class="small">@user.AccountLevel</td>
                        <td><EarnPlatform.Components.Shared.StatusBadge Status="@user.AccountStatus.ToString()" /></td>
                        <td class="small">@EarnPlatform.Common.DisplayTime.Format(user.CreatedAt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (filtered.Count == 0)
    {
        <div class="text-center text-muted py-4">No users match your filters.</div>
    }
}

@code {
    private List<UserAccount>? _users;
    private string _search = string.Empty;
    private bool _todayOnly;

    protected override async Task OnInitializedAsync()
    {
        _users = await UserAccountRepository.GetAllWithPackageAsync();
    }
}