@page "/user/guide"
@attribute [Authorize(Policy = "RequireActiveUser")]
@layout Components.Layout.UserLayout

<PageTitle>Guide</PageTitle>

<h4 class="fw-bold mb-3">How It Works</h4>

<div class="card p-3">
    <h6 class="fw-bold"><i class="bi bi-1-circle-fill text-primary me-1"></i> Getting Started</h6>
    <p class="text-muted">Sign up, choose a package, and submit payment proof. Once approved by an admin, your account is activated.</p>

    <h6 class="fw-bold mt-3"><i class="bi bi-2-circle-fill text-primary me-1"></i> Completing Tasks</h6>
    <p class="text-muted">Visit the Work page daily and complete up to your package's daily ad limit to earn rewards.</p>

    <h6 class="fw-bold mt-3"><i class="bi bi-3-circle-fill text-primary me-1"></i> Referrals</h6>
    <p class="text-muted">Share your referral link from the dashboard. New members who sign up through your link join your team.</p>

    <h6 class="fw-bold mt-3"><i class="bi bi-4-circle-fill text-primary me-1"></i> Withdrawals</h6>
    <p class="text-muted">Request a withdrawal from your Wallet page via JazzCash or Easypaisa. Requests are reviewed by an admin before funds are released.</p>
</div>