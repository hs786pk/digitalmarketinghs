@page "/user/pending-approval"
@attribute [Authorize(Policy = "RequireUserRole")]
@layout Components.Layout.AuthLayout
@using EarnPlatform.Models
@using EarnPlatform.Services.Interfaces
@inject ICurrentUserService CurrentUserService
@inject IAuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Awaiting Approval</PageTitle>

@if (_user == null)
{
    <div class="text-center py-5"><span class="spinner-border text-primary"></span></div>
}
else
{
    <div class="auth-card text-center">
        <i class="bi bi-hourglass-split text-warning approval-icon"></i>
        <h4 class="fw-bold mt-3">Account Under Review</h4>
        @if (_user.AccountStatus == AccountStatus.Rejected)
        {
            <p class="text-muted">Hi @_user.FirstName, your payment/account approval was rejected. Please review the issue and submit a new payment proof.</p>
            <a href="/packages" class="btn btn-primary mt-2 me-2">Choose Package</a>
        }
        else if (_user.AccountStatus == AccountStatus.Suspended)
        {
            <p class="text-muted">Hi @_user.FirstName, your account is currently suspended. Please contact support for assistance.</p>
        }
        else
        {
            <p class="text-muted">Hi @_user.FirstName, your payment is being reviewed by our team. You'll get full access to your dashboard as soon as it's approved.</p>
        }
        <form method="post" action="/account/logout" class="d-inline">
            <AntiforgeryToken /><button type="submit" class="btn btn-outline-secondary mt-2">
            <i class="bi bi-box-arrow-right me-1"></i> Logout
        </button></form>
    </div>
}

@code {
    private UserAccount? _user;

    protected override async Task OnInitializedAsync()
    {
        _user = await CurrentUserService.GetCurrentUserAccountAsync();

        if (_user == null)
        {
            NavigationManager.NavigateTo("/login", forceLoad: true);
            return;
        }

        // If they've since been approved (e.g. re-visiting this URL directly),
        // send them on to the real dashboard instead of stranding them here.
        if (_user.AccountStatus == AccountStatus.Active)
            NavigationManager.NavigateTo("/user");
    }
}