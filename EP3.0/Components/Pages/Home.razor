@page "/"
@attribute [ExcludeFromInteractiveRouting]
@layout Components.Layout.PublicLayout
@using Microsoft.AspNetCore.Components.Endpoints

<PageTitle>Digital-Marketing Group | Online Rewards & Earning Platform in Pakistan</PageTitle>

<HeadContent>
    <meta name="description"
          content="Digital-Marketing Group helps users earn rewards through tasks, referrals, wallet rewards and secure withdrawal management." />

    <meta name="robots" content="index, follow" />

    <link rel="canonical" href="https://digital-marketingpk.com/" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Digital-Marketing Group | Online Rewards & Earning Platform in Pakistan" />
    <meta property="og:description"
          content="Digital-Marketing Group helps users earn rewards through tasks, referrals, wallet rewards and secure withdrawal management." />
    <meta property="og:url" content="https://digital-marketingpk.com/" />
    <meta property="og:site_name" content="Digital-Marketing Group" />
    <meta property="og:image" content="https://digital-marketingpk.com/images/og-image.jpg" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Digital-Marketing Group | Online Rewards & Earning Platform in Pakistan" />
    <meta name="twitter:description"
          content="Digital-Marketing Group helps users earn rewards through tasks, referrals, wallet rewards and secure withdrawal management." />
    <meta name="twitter:image" content="https://digital-marketingpk.com/images/og-image.jpg" />

    <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "Organization",
              "name": "Digital-Marketing Group",
              "url": "https://digital-marketingpk.com/",
              "logo": "https://digital-marketingpk.com/favicon.png",
              "description": "Digital-Marketing Group helps users earn rewards through tasks, referrals, wallet rewards and secure withdrawal management."
            }
    </script>

    <script type="application/ld+json">
            {
              "@@context": "https://schema.org",
              "@@type": "FAQPage",
              "mainEntity": [
                {
                  "@@type": "Question",
                  "name": "How do users earn rewards?",
                  "acceptedAnswer": { "@@type": "Answer", "text": "Users earn rewards by completing available tasks on the platform. Once a completed task is verified, the reward is credited to the user's wallet." }
                },
                {
                  "@@type": "Question",
                  "name": "How does the referral system work?",
                  "acceptedAnswer": { "@@type": "Answer", "text": "Every user gets a unique referral code. When someone registers using that code and becomes a successful member, the referring user receives a referral reward according to platform rules." }
                },
                {
                  "@@type": "Question",
                  "name": "How are rewards added to the wallet?",
                  "acceptedAnswer": { "@@type": "Answer", "text": "Once a task is approved or a referral is confirmed, the reward is automatically added to the user's wallet balance and recorded in the transaction history." }
                },
                {
                  "@@type": "Question",
                  "name": "How can users withdraw earnings?",
                  "acceptedAnswer": { "@@type": "Answer", "text": "Eligible users can submit a withdrawal request from their wallet. Requests are reviewed by the admin team and paid out through supported payment methods such as JazzCash and Easypaisa." }
                },
                {
                  "@@type": "Question",
                  "name": "What are account levels?",
                  "acceptedAnswer": { "@@type": "Answer", "text": "Account levels reflect a user's progress on the platform. Successful referrals contribute toward level progression, and higher levels unlock eligibility for additional platform benefits." }
                },
                {
                  "@@type": "Question",
                  "name": "How do tasks work?",
                  "acceptedAnswer": { "@@type": "Answer", "text": "Users access available tasks from their dashboard, complete them, and submit them for verification. Approved tasks are credited to the wallet, subject to daily limits." }
                }
              ]
            }
    </script>
</HeadContent>

<AuthRedirect />

<!-- ============ HERO: asymmetric editorial split ============ -->
<section class="hm-hero" aria-labelledby="hero-title">
    <div class="hm-wrap hm-hero-grid">
        <div class="hm-hero-copy">
            <p class="hm-kicker">Task-based earning &middot; Pakistan</p>
            <h1 id="hero-title" class="hm-title">
                Earn through tasks.
                <span class="hm-title-mark">Build rewards.</span>
                Grow your network.
            </h1>
            <p class="hm-lede">
                Complete platform tasks, earn transparent rewards, unlock referral bonuses, and manage withdrawals &mdash;
                all from one secure account designed for clear, everyday earning in Pakistan.
            </p>
            <div class="hm-actions">
                <a href="/signup" class="btn btn-accent btn-lg">Create Account</a>
                <a href="/login" class="btn btn-outline-ink btn-lg">Login</a>
            </div>
            <p class="hm-fine">
                Rewards come only from completed tasks and successful referrals. No investment products,
                no guaranteed returns.
            </p>
        </div>

        <div class="hm-statement-wrap">
            <figure class="hm-statement mb-0" aria-label="Illustration of a wallet statement">
                <div class="hm-statement-head">
                    <h2 class="hm-statement-title">Wallet statement</h2>
                    <span class="hm-statement-tag">Illustration</span>
                </div>
                <ul class="hm-statement-rows">
                    <li class="hm-row">
                        <span class="hm-row-label">Task reward</span>
                        <span class="hm-row-amt" aria-hidden="true">PKR &middot;&middot;&middot;&middot;</span>
                        <span class="hm-row-sub">Verified &middot; credited to wallet</span>
                    </li>
                    <li class="hm-row">
                        <span class="hm-row-label">Referral reward</span>
                        <span class="hm-row-amt" aria-hidden="true">PKR &middot;&middot;&middot;&middot;</span>
                        <span class="hm-row-sub">Member joined &middot; credited to wallet</span>
                    </li>
                    <li class="hm-row">
                        <span class="hm-row-label">Withdrawal request</span>
                        <span class="hm-row-amt" aria-hidden="true">PKR &middot;&middot;&middot;&middot;</span>
                        <span class="hm-row-sub">JazzCash / Easypaisa &middot; in admin review</span>
                    </li>
                </ul>
                <figcaption class="hm-statement-foot">
                    Layout preview only. Amounts are not real figures &mdash; your own balance and
                    history appear after you sign in.
                </figcaption>
            </figure>
        </div>
    </div>
</section>

<!-- ============ HOW IT WORKS: four numbered columns ============ -->
<section id="how" class="hm-section hm-section-tint" aria-labelledby="how-title">
    <div class="hm-wrap">
        <div class="hm-head reveal">
            <p class="hm-kicker">How it works</p>
            <h2 id="how-title" class="hm-h2">From sign-up to wallet in four steps.</h2>
        </div>
        <ol class="hm-steps reveal">
            <li class="hm-step">
                <span class="hm-step-num" aria-hidden="true">01</span>
                <h3>Create account</h3>
                <p>Users register and create their platform account.</p>
            </li>
            <li class="hm-step">
                <span class="hm-step-num" aria-hidden="true">02</span>
                <h3>Complete tasks</h3>
                <p>Users complete available tasks and receive approved rewards.</p>
            </li>
            <li class="hm-step">
                <span class="hm-step-num" aria-hidden="true">03</span>
                <h3>Earn rewards</h3>
                <p>Rewards are added to the user's wallet after successful completion.</p>
            </li>
            <li class="hm-step">
                <span class="hm-step-num" aria-hidden="true">04</span>
                <h3>Withdraw earnings</h3>
                <p>Eligible users can request withdrawals through supported payment methods.</p>
            </li>
        </ol>
    </div>
</section>

<!-- ============ REWARD SYSTEM ============ -->
<section id="rewards" class="hm-section" aria-labelledby="rewards-title">
    <div class="hm-wrap hm-split">
        <div class="reveal">
            <p class="hm-kicker">Reward system</p>
            <h2 id="rewards-title" class="hm-h2">Every reward, in the open.</h2>
            <p class="hm-lede">
                Every reward on Digital-Marketing Group is transparent and traceable &mdash; from task completion
                rewards and referral rewards to wallet reward tracking and a full transaction history.
            </p>
            <dl class="hm-dl">
                <div class="hm-dl-row">
                    <i class="bi bi-list-check" aria-hidden="true"></i>
                    <dt>Task completion rewards</dt>
                    <dd>Earned when a submitted task is verified.</dd>
                </div>
                <div class="hm-dl-row">
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <dt>Referral rewards</dt>
                    <dd>Earned when a referred member successfully joins.</dd>
                </div>
                <div class="hm-dl-row">
                    <i class="bi bi-wallet2" aria-hidden="true"></i>
                    <dt>Wallet reward tracking</dt>
                    <dd>See what is available, pending and withdrawn.</dd>
                </div>
                <div class="hm-dl-row">
                    <i class="bi bi-journal-text" aria-hidden="true"></i>
                    <dt>Full transaction history</dt>
                    <dd>Every credit and withdrawal is recorded.</dd>
                </div>
            </dl>
        </div>

        <ol class="hm-timeline reveal" aria-label="How a task reward reaches your wallet">
            <li class="hm-tl-item">
                <h3>Complete task</h3>
                <p>Finish an available task from your dashboard and submit it.</p>
            </li>
            <li class="hm-tl-item">
                <h3>Task approval</h3>
                <p>The submission is checked before anything is credited.</p>
            </li>
            <li class="hm-tl-item">
                <h3>Reward added</h3>
                <p>Approved tasks credit their reward, subject to daily limits.</p>
            </li>
            <li class="hm-tl-item hm-tl-final">
                <h3>Wallet balance updated</h3>
                <p>The credit appears in your balance and transaction history.</p>
            </li>
        </ol>
    </div>
</section>

<!-- ============ REFERRAL SYSTEM: full-bleed band ============ -->
<section class="hm-band" aria-labelledby="referral-title">
    <div class="hm-wrap hm-split hm-split-flip">
        <div class="reveal">
            <p class="hm-kicker">Referral system</p>
            <h2 id="referral-title" class="hm-band-title">Your code. <span>Their start.</span> Your reward.</h2>
            <p class="hm-lede mb-0">
                Share your unique referral code with others. Users receive referral rewards when referred
                members successfully join according to platform rules &mdash; helping you grow your network while
                they start earning too.
            </p>
        </div>

        <ol class="hm-chain reveal" aria-label="How a referral reward works">
            <li class="hm-chain-item"><span aria-hidden="true">01</span> Your referral code</li>
            <li class="hm-chain-item"><span aria-hidden="true">02</span> New user registration</li>
            <li class="hm-chain-item"><span aria-hidden="true">03</span> Successful referral</li>
            <li class="hm-chain-item"><span aria-hidden="true">04</span> Referral reward</li>
        </ol>
    </div>
</section>

<!-- ============ ACCOUNT LEVELS: a staircase ============ -->
<section class="hm-section" aria-labelledby="levels-title">
    <div class="hm-wrap">
        <div class="hm-head reveal mx-auto text-center">
            <p class="hm-kicker">Account levels</p>
            <h2 id="levels-title" class="hm-h2">Climb as your network grows.</h2>
            <p class="hm-lede mx-auto mb-0">
                Successful referrals contribute toward account level progression.
                Higher levels unlock eligibility for additional platform benefits.
            </p>
        </div>

        <ol class="hm-levels reveal" aria-label="Account levels one to five">
            <li class="hm-level">
                <span class="hm-level-num">1</span>
                <span class="hm-level-label">Level</span>
                <span class="hm-level-benefit">Starter access</span>
            </li>
            <li class="hm-level">
                <span class="hm-level-num">2</span>
                <span class="hm-level-label">Level</span>
                <span class="hm-level-benefit">Faster tasks</span>
            </li>
            <li class="hm-level">
                <span class="hm-level-num">3</span>
                <span class="hm-level-label">Level</span>
                <span class="hm-level-benefit">Higher daily limits</span>
            </li>
            <li class="hm-level">
                <span class="hm-level-num">4</span>
                <span class="hm-level-label">Level</span>
                <span class="hm-level-benefit">Priority review</span>
            </li>
            <li class="hm-level hm-level-top">
                <span class="hm-level-num">5</span>
                <span class="hm-level-label">Level</span>
                <span class="hm-level-benefit">Full benefits</span>
            </li>
        </ol>
    </div>
</section>
<!-- ============ WALLET + WITHDRAWALS ============ -->
<section id="wallet" class="hm-section hm-section-tint" aria-labelledby="wallet-title">
    <div class="hm-wrap hm-split hm-split-flip">
        <div class="reveal">
            <p class="hm-kicker">Wallet system</p>
            <h2 id="wallet-title" class="hm-h2">One place for every rupee.</h2>
            <p class="hm-lede">
                Track everything in one place &mdash; available balance, earned rewards, referral rewards, withdrawal
                history and full transaction records.
            </p>
            <dl class="hm-dl">
                <div class="hm-dl-row">
                    <i class="bi bi-wallet2" aria-hidden="true"></i>
                    <dt>Available balance</dt>
                    <dd>What you can request to withdraw.</dd>
                </div>
                <div class="hm-dl-row">
                    <i class="bi bi-gift" aria-hidden="true"></i>
                    <dt>Earned &amp; referral rewards</dt>
                    <dd>Totals for task and referral credits.</dd>
                </div>
                <div class="hm-dl-row">
                    <i class="bi bi-cash-stack" aria-hidden="true"></i>
                    <dt>Withdrawal history</dt>
                    <dd>Each request, with its status and remarks.</dd>
                </div>
            </dl>
        </div>

        <div class="reveal">
            <h3 class="h4 mb-2">Withdrawal system</h3>
            <p class="text-muted mb-4">
                Withdrawal requests go through an admin review step before approval, with every step
                tracked in your transaction history.
            </p>
            <ol class="hm-timeline" aria-label="How a withdrawal is processed">
                <li class="hm-tl-item">
                    <h3>Available balance</h3>
                    <p>Start from the balance in your wallet.</p>
                </li>
                <li class="hm-tl-item">
                    <h3>Withdrawal request</h3>
                    <p>Choose a supported payment method and submit.</p>
                </li>
                <li class="hm-tl-item">
                    <h3>Admin review</h3>
                    <p>Our team reviews every request before it is approved or rejected.</p>
                </li>
                <li class="hm-tl-item hm-tl-final">
                    <h3>Wallet updated</h3>
                    <p>The outcome is recorded in your history.</p>
                </li>
            </ol>
            <div class="hm-methods" aria-label="Supported payment methods">
                <span class="hm-method"><i class="bi bi-phone" aria-hidden="true"></i> JazzCash</span>
                <span class="hm-method"><i class="bi bi-phone" aria-hidden="true"></i> Easypaisa</span>
            </div>
        </div>
    </div>
</section>

<!-- ============ TASK SYSTEM ============ -->
<section class="hm-section" aria-labelledby="tasks-title">
    <div class="hm-wrap">
        <div class="hm-head reveal">
            <p class="hm-kicker">Task system</p>
            <h2 id="tasks-title" class="hm-h2">Fair, checked, and capped.</h2>
            <p class="hm-lede mb-0">
                Users access available tasks from their dashboard. After completing a task:
            </p>
        </div>

        <div class="hm-cols reveal">
            <div class="hm-col">
                <i class="bi bi-patch-check" aria-hidden="true"></i>
                <h3>Completion verified</h3>
                <p>Every submitted task is checked before it is approved.</p>
            </div>
            <div class="hm-col">
                <i class="bi bi-coin" aria-hidden="true"></i>
                <h3>Rewards credited</h3>
                <p>Approved tasks credit rewards straight to the wallet.</p>
            </div>
            <div class="hm-col">
                <i class="bi bi-clock-history" aria-hidden="true"></i>
                <h3>Daily limits respected</h3>
                <p>Fair usage limits keep the system sustainable for everyone.</p>
            </div>
        </div>
    </div>
</section>
<!-- ============ FAQ ============ -->
<section id="faq" class="hm-section hm-section-tint" aria-labelledby="faq-title">
    <div class="hm-wrap hm-faq-layout">
        <div class="hm-faq-intro reveal">
            <p class="hm-kicker">FAQ</p>
            <h2 id="faq-title" class="hm-h2">Frequently asked questions</h2>
            <p class="text-muted mb-0">Straight answers about tasks, referrals, wallets and withdrawals.</p>
        </div>
        <div class="hm-faq reveal">
            <details class="hm-faq-item">
                <summary>How do users earn rewards?</summary>
                <p>Users earn rewards by completing available tasks. Once a completed task is verified, the reward is credited to the user's wallet.</p>
            </details>
            <details class="hm-faq-item">
                <summary>How does the referral system work?</summary>
                <p>Every user gets a unique referral code. When someone registers using that code and becomes a successful member, the referring user receives a referral reward according to platform rules.</p>
            </details>
            <details class="hm-faq-item">
                <summary>How are rewards added to the wallet?</summary>
                <p>Once a task is approved or a referral is confirmed, the reward is added to the user's wallet balance and recorded in the transaction history.</p>
            </details>
            <details class="hm-faq-item">
                <summary>How can users withdraw earnings?</summary>
                <p>Eligible users can submit a withdrawal request from their wallet. Requests are reviewed by the admin team and paid out through supported payment methods such as JazzCash and Easypaisa.</p>
            </details>
            <details class="hm-faq-item">
                <summary>What are account levels?</summary>
                <p>Account levels reflect a user's progress on the platform. Successful referrals contribute toward level progression, and higher levels unlock eligibility for additional platform benefits.</p>
            </details>
            <details class="hm-faq-item">
                <summary>How do tasks work?</summary>
                <p>Users access available tasks from their dashboard, complete them, and submit them for verification. Approved tasks are credited to the wallet, subject to daily limits.</p>
            </details>
        </div>
    </div>
</section>

<!-- ============ FINAL CTA ============ -->
<section class="hm-cta" aria-labelledby="cta-title">
    <div class="hm-wrap reveal">
        <h2 id="cta-title" class="hm-cta-title">Start with clarity.</h2>
        <p class="hm-cta-desc">
            Create your account, complete tasks, and track every reward in one wallet.
            No investment products. No guaranteed returns.
        </p>
        <div class="hm-actions">
            <a href="/signup" class="btn btn-accent btn-lg">Create Account</a>
            <a href="/login" class="btn btn-outline-ink btn-lg">Login</a>
        </div>
    </div>
</section>